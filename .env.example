# Copy to .env and fill in. Never commit the real file.
# Values are the operator's alone; no agent may read, print or store them.

# Supabase (Lovable connector). Publishable keys are public by design.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. These must never reach a browser bundle.
REPLICATE_API_KEY=
OPERATOR_API_TOKEN=
